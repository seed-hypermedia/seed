{
  "name": "Agent run",
  "description": "The durable record of one unit of agent work: a model turn, a headless tool call, or a workflow script. Conceptually distinct from the conversation (agent-message) and from tool activity records: a run is the execution, with its status, lineage (parent run, owning session), pinned source, input and output, plan, and cumulative usage. sourceCid pins the exact script a workflow replays against.",
  "type": "hm://z6MkmZUb4K5c17zGGBuJJerwFzBaGkiYLfEEnkb9CH1W1ptb/map",
  "required": ["id", "status"],
  "properties": {
    "id": {"type": "hm://z6MkmZUb4K5c17zGGBuJJerwFzBaGkiYLfEEnkb9CH1W1ptb/string"},
