{
  "name": "@seed-hypermedia/agents-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test:package": "node scripts/build.mjs && node scripts/test-package.mjs",
    "test:package:install": "node scripts/build.mjs && node scripts/test-package.mjs --install"
  },
  "dependencies": {
    "@seed-hypermedia/agents-protocol": "workspace:*",
    "@seed-hypermedia/client": "workspace:*",
    "@shm/editor": "workspace:*",
    "@shm/shared": "workspace:*",
    "@shm/ui": "workspace:*",
    "@tanstack/react-query": "^4.36.1"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.1.18",
    "@tailwindcss/oxide": "4.1.18",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.1.3",
    "typescript": "5.8.3",
    "vite": "6.4.2",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  }
}
