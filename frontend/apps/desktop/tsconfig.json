{
  "compilerOptions": {
    // "target": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "module": "commonjs",
    "baseUrl": ".",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [],
    "paths": {
      // @electron/fuses exposes types through exports; bridge the legacy node resolver.
      "@electron/fuses": ["../../../node_modules/@electron/fuses/dist/index"],
      "@/*": ["./src/*"],
      "@shm/ui": ["../../packages/ui/src/index.tsx"],
      "@shm/ui/*": ["../../packages/ui/src/*"],
      "@seed-hypermedia/client": ["../../packages/client/src/index.ts"],
      "@seed-hypermedia/client/*": ["../../packages/client/src/*"],
      "@seed-hypermedia/agents-protocol": ["../../../agents/protocol/src/index.ts"],
      "@shm/shared": ["../../packages/shared/src/index.ts"],
      "@shm/shared/*": ["../../packages/shared/src/*"],
      "@shm/editor/*": ["../../packages/editor/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
    // "../../packages/ui/src/forms.tsx",
    // "../../packages/ui/src/form-input.tsx",
    // "../../packages/shared/src/utils/navigation.tsx"
  ],
  "exclude": ["node_modules"]
}
