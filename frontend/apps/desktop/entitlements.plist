<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The bundled microsandbox `msb` helper creates hardware-isolated microVMs for the agents
         server's execute_code tool; osx-sign re-signs it with these entitlements, so the
         hypervisor grant must be here or VM creation fails in the notarized app. -->
    <key>com.apple.security.hypervisor</key>
    <true/>
    <!-- Device/media grants matching @electron/osx-sign's default.darwin.plist, which shipped
         builds were signed with while the flat entitlements option was silently ignored.
         Kept so switching to optionsForFile doesn't regress camera/mic/etc under hardened
         runtime. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.bluetooth</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.print</key>
    <true/>
    <key>com.apple.security.device.usb</key>
    <true/>
    <key>com.apple.security.personal-information.location</key>
    <true/>
  </dict>
</plist>