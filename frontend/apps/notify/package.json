{
  "name": "@shm/notify",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "build": "bun build app/main.ts --target bun --outdir build --sourcemap=linked",
    "dev": "PORT=${PORT:-3060} DAEMON_HTTP_PORT=58001 DAEMON_FILE_URL=\"http://localhost:58001/ipfs\" SEED_BASE_URL=\"http://localhost:3000\" bun --watch app/main.ts",
    "start": "DAEMON_HTTP_PORT=58001 DAEMON_FILE_URL=\"http://localhost:58001/ipfs\" bun app/main.ts",
    "start:prod": "bun build/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run && bun test bun.test",
    "test:w": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "1.10.0",
    "@connectrpc/connect": "1.4.0",
    "@connectrpc/connect-web": "1.4.0",
    "@ipld/dag-cbor": "^9.2.2",
    "@seed-hypermedia/client": "workspace:*",
    "@sentry/bun": "10.49.0",
    "@shm/emails": "workspace:*",
    "@shm/shared": "workspace:*",
    "multiformats": "^13.3.2",
    "nodemailer": "^10.0.10",
    "react": "18.2.0 || 19.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@types/mjml": "^4.7.4",
    "@types/mjml-core": "^4.15.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "18.2.64",
    "typescript": "5.8.3",
    "vitest": "4.1.8"
  }
}
