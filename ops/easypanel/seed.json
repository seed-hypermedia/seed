{
  "services": [
    {
      "type": "app",
      "data": {
        "serviceName": "daemon",
        "source": {
          "type": "image",
          "image": "seedhypermedia/site:latest"
        },
        "env": "SEED_LOG_LEVEL=info\nLIGHTNING_API_URL=https://ln.seed.hyper.media\nSENTRY_DSN=https://47c66bd7a6d64db68a59c03f2337e475@o4504088793841664.ingest.sentry.io/4505527493328896",
        "deploy": {
          "command": "seed-daemon -data-dir=/data -keystore-dir=/data/keys -lndhub.mainnet -p2p.port=56000 -http.port=56001 -grpc.port=56002 -p2p.no-relay=true -p2p.force-reachability-public=true -syncing.smart=true -syncing.no-sync-back=true -p2p.announce-addrs=/dns4/seed.example.com/tcp/56000,/dns4/seed.example.com/udp/56000/quic-v1"
        },
        "ports": [
          {
            "published": 56000,
            "target": 56000,
            "protocol": "tcp"
          },
          {
            "published": 56000,
            "target": 56000,
            "protocol": "udp"
          }
        ],
        "mounts": [
          {
            "type": "volume",
            "name": "data",
            "mountPath": "/data"
          }
        ],
        "domains": [
          {
            "host": "seed.example.com",
            "port": 56001,
            "path": "/ipfs/"
          }
        ]
      }
    },
    {
      "type": "app",
      "data": {
        "serviceName": "web",
        "source": {
          "type": "image",
          "image": "seedhypermedia/web:latest"
        },
        "env": "SEED_BASE_URL=https://seed.example.com\nSEED_ASSET_HOST=https://seed.example.com\nDAEMON_HTTP_URL=http://$(PROJECT_NAME)_daemon:56001\nSEED_LINK_SECRET=REPLACE_WITH_SECRET\nNOTIFY_SERVICE_HOST=https://notify.seed.hyper.media\nSEED_IS_GATEWAY=false\nSEED_ENABLE_STATISTICS=false\nPORT=3000\nDATA_DIR=/data",
        "deploy": {
          "command": "sh -c 'if [ -z \"$SEED_LINK_SECRET\" ] || [ \"$SEED_LINK_SECRET\" = \"REPLACE_WITH_SECRET\" ]; then echo \"SEED_LINK_SECRET must be set to a unique secret before starting Seed web.\" >&2; exit 1; fi; if [ ! -f /data/config.json ]; then printf \"{\\\"availableRegistrationSecret\\\":\\\"%s\\\"}\\n\" \"$SEED_LINK_SECRET\" > /data/config.json; fi; exec npm run start:prod'"
        },
        "mounts": [
          {
            "type": "volume",
            "name": "data",
            "mountPath": "/data"
          }
        ],
        "domains": [
          {
            "host": "seed.example.com",
            "port": 3000
          }
        ]
      }
    },
    {
      "type": "app",
      "data": {
        "serviceName": "updater",
        "source": {
          "type": "image",
          "image": "containrrr/shepherd:v1.8.1"
        },
        "env": "SLEEP_TIME=600s\nFILTER_SERVICES=name=$(PROJECT_NAME)_\nIGNORELIST_SERVICES=$(PROJECT_NAME)_updater\nROLLBACK_ON_FAILURE=true",
        "mounts": [
          {
            "type": "bind",
            "hostPath": "/var/run/docker.sock",
            "mountPath": "/var/run/docker.sock"
          }
        ]
      }
    }
  ]
}
