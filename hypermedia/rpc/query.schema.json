{
  "type": "hm://hyper.media/struct",
  "properties": {
    "key": {
      "value": "Query",
      "required": true,
      "description": "Method key, always `Query`."
    },
    "input": {
      "value": {
        "type": "hm://hyper.media/query"
      },
      "required": true,
      "description": "The document query to run."
    },
    "output": {
      "value": {
        "anyOf": [
          {
            "type": "hm://hyper.media/rpc/type/query-result"
          },
          {
            "type": "hm://hyper.media/null"
          }
        ]
      },
      "required": true,
      "description": "The matching documents, or `null`."
    }
  },
  "description": "Runs a document query (the same shape a Query block embeds) and returns the matching documents as a query result, or null."
}
