{
  "type": "hm://hyper.media/struct",
  "properties": {
    "key": {
      "value": "ListChanges",
      "required": true,
      "description": "Method key, always `ListChanges`."
    },
    "input": {
      "value": {
        "type": "hm://hyper.media/struct",
        "properties": {
          "targetId": {
            "value": {
              "type": "hm://hyper.media/rpc/type/id"
            },
            "required": true,
            "description": "Id of the document."
          }
        }
      },
      "required": true,
      "description": "The document whose history to list."
    },
    "output": {
      "value": {
        "type": "hm://hyper.media/struct",
        "properties": {
          "changes": {
            "value": {
              "type": "hm://hyper.media/list",
              "items": {
                "type": "hm://hyper.media/rpc/type/raw-document-change"
              }
            },
            "required": true,
            "description": "Raw change records of the document."
          },
          "latestVersion": {
            "value": {
              "type": "hm://hyper.media/string"
            },
            "description": "Version of the document's latest state; empty when the document was not found."
          }
        }
      },
      "required": true,
      "description": "The document's change history."
    }
  },
  "description": "Returns a document's change history as raw change records plus its latest version, given the target id."
}
