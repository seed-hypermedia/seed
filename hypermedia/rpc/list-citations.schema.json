{
  "type": "hm://hyper.media/struct",
  "properties": {
    "key": {
      "value": "ListCitations",
      "required": true,
      "description": "Method key, always `ListCitations`."
    },
    "input": {
      "value": {
        "type": "hm://hyper.media/struct",
        "properties": {
          "targetId": {
            "value": {
              "type": "hm://hyper.media/rpc/type/id"
            },
            "required": true,
            "description": "Id of the cited resource."
          }
        }
      },
      "required": true,
      "description": "The resource whose citations to list."
    },
    "output": {
      "value": {
        "type": "hm://hyper.media/struct",
        "properties": {
          "citations": {
            "value": {
              "type": "hm://hyper.media/list",
              "items": {
                "type": "hm://hyper.media/rpc/type/raw-citation"
              }
            },
            "required": true,
            "description": "Raw citation records pointing at the target."
          }
        }
      },
      "required": true,
      "description": "Citations of the target."
    }
  },
  "description": "Returns the raw citations that point at a target resource, given its id."
}
