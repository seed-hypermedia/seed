{
  "type": "hm://hyper.media/struct",
  "properties": {
    "id": {
      "value": {
        "type": "hm://hyper.media/string"
      },
      "required": true,
      "description": "The packed `hm://` identifier string."
    },
    "uid": {
      "value": {
        "type": "hm://hyper.media/string"
      },
      "required": true,
      "description": "Account uid the resource belongs to."
    },
    "path": {
      "value": {
        "anyOf": [
          {
            "type": "hm://hyper.media/list",
            "items": {
              "type": "hm://hyper.media/string"
            }
          },
          {
            "type": "hm://hyper.media/null"
          }
        ]
      },
      "required": true,
      "description": "Path segments within the account, or `null` for the home document."
    },
    "version": {
      "value": {
        "anyOf": [
          {
            "type": "hm://hyper.media/string"
          },
          {
            "type": "hm://hyper.media/null"
          }
        ]
      },
      "required": true,
      "description": "Pinned version, or `null` for the latest."
    },
    "blockRef": {
      "value": {
        "anyOf": [
          {
            "type": "hm://hyper.media/string"
          },
          {
            "type": "hm://hyper.media/null"
          }
        ]
      },
      "required": true,
      "description": "Id of the referenced block, or `null`."
    },
    "blockRange": {
      "value": {
        "anyOf": [
          {
            "type": "hm://hyper.media/rpc/type/block-range"
          },
          {
            "type": "hm://hyper.media/null"
          }
        ]
      },
      "required": true,
      "description": "Selection within the referenced block, or `null`."
    },
    "hostname": {
      "value": {
        "anyOf": [
          {
            "type": "hm://hyper.media/string"
          },
          {
            "type": "hm://hyper.media/null"
          }
        ]
      },
      "required": true,
      "description": "Site hostname to build site-style URLs with, or `null` to use the gateway form."
    },
    "scheme": {
      "value": {
        "anyOf": [
          {
            "type": "hm://hyper.media/string"
          },
          {
            "type": "hm://hyper.media/null"
          }
        ]
      },
      "required": true,
      "description": "URL scheme the id was parsed from, or `null`."
    },
    "latest": {
      "value": {
        "anyOf": [
          {
            "type": "hm://hyper.media/boolean"
          },
          {
            "type": "hm://hyper.media/null"
          }
        ]
      },
      "description": "When `true` alongside a version, prefer the latest version over the pinned one."
    }
  },
  "description": "A parsed `hm://` identifier as clients pass it around, with `null` for whatever the URL does not carry."
}
