{
  "type": "hm://hyper.media/struct",
  "properties": {
    "comments": {
      "value": {
        "type": "hm://hyper.media/list",
        "items": {
          "type": "hm://hyper.media/rpc/type/comment"
        }
      },
      "required": true,
      "description": "The comments returned."
    },
    "authors": {
      "value": {
        "type": "hm://hyper.media/map",
        "values": {
          "type": "hm://hyper.media/rpc/type/metadata-payload"
        }
      },
      "required": true,
      "description": "Metadata payloads of the comment authors, keyed by account uid."
    }
  },
  "description": "A list of comments plus the metadata payloads of every author involved."
}
