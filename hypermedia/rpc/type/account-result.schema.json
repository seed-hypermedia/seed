{
  "anyOf": [
    {
      "type": "hm://hyper.media/struct",
      "properties": {
        "type": {
          "value": "account",
          "required": true,
          "description": "Discriminator: the account was found."
        },
        "id": {
          "value": {
            "type": "hm://hyper.media/rpc/type/id"
          },
          "required": true,
          "description": "Parsed id of the account's home document."
        },
        "metadata": {
          "value": {
            "anyOf": [
              {
                "type": "hm://hyper.media/metadata"
              },
              {
                "type": "hm://hyper.media/null"
              }
            ]
          },
          "required": true,
          "description": "Resolved metadata of the account's home document, or `null` when it has none."
        },
        "hasSite": {
          "value": {
            "type": "hm://hyper.media/boolean"
          },
          "description": "Whether the account's home document has content, so the account has a site to show."
        }
      }
    },
    {
      "type": "hm://hyper.media/struct",
      "properties": {
        "type": {
          "value": "account-not-found",
          "required": true,
          "description": "Discriminator: no account was found for the uid."
        },
        "uid": {
          "value": {
            "type": "hm://hyper.media/string"
          },
          "required": true,
          "description": "The account uid that was looked up."
        }
      }
    }
  ],
  "description": "The result of resolving an account: its metadata payload, or an explicit not-found."
}
