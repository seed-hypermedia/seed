{
  "type": "hm://hyper.media/struct",
  "properties": {
    "content": {
      "value": {
        "type": "hm://hyper.media/list",
        "items": {
          "type": "hm://hyper.media/block/node"
        }
      }
    },
    "version": {
      "value": {
        "type": "hm://hyper.media/string"
      }
    },
    "account": {
      "value": {
        "type": "hm://hyper.media/string"
      }
    },
    "authors": {
      "value": {
        "type": "hm://hyper.media/list",
        "items": {
          "type": "hm://hyper.media/string"
        }
      },
      "required": true
    },
    "path": {
      "value": {
        "type": "hm://hyper.media/string"
      }
    },
    "createTime": {
      "value": {
        "anyOf": [
          {
            "type": "hm://hyper.media/timestamp"
          },
          {
            "type": "hm://hyper.media/string"
          }
        ]
      }
    },
    "updateTime": {
      "value": {
        "anyOf": [
          {
            "type": "hm://hyper.media/timestamp"
          },
          {
            "type": "hm://hyper.media/string"
          }
        ]
      }
    },
    "metadata": {
      "value": {
        "type": "hm://hyper.media/metadata"
      },
      "required": true
    },
    "detachedBlocks": {
      "value": {
        "type": "hm://hyper.media/map",
        "values": {
          "type": "hm://hyper.media/block/node"
        }
      }
    },
    "genesis": {
      "value": {
        "type": "hm://hyper.media/string"
      },
      "required": true
    },
    "generationInfo": {
      "value": {
        "type": "hm://hyper.media/struct",
        "properties": {
          "genesis": {
            "value": {
              "type": "hm://hyper.media/string"
            },
            "required": true
          },
          "generation": {
            "value": {
              "type": "hm://hyper.media/integer"
            },
            "required": true
          }
        }
      }
    },
    "visibility": {
      "value": {
        "type": "hm://hyper.media/visibility"
      },
      "required": true
    }
  }
}
