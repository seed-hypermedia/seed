{
  "type": "hm://hyper.media/struct",
  "properties": {
    "key": {
      "value": "QueryBlock",
      "required": true,
      "description": "Method key, always `QueryBlock`."
    },
    "input": {
      "value": {
        "type": "hm://hyper.media/struct",
        "properties": {
          "query": {
            "value": {
              "type": "hm://hyper.media/query"
            },
            "required": true,
            "description": "The query as embedded in a Query block."
          }
        }
      },
      "required": true,
      "description": "The Query block's query."
    },
    "output": {
      "value": {
        "anyOf": [
          {
            "type": "hm://hyper.media/rpc/type/query-block-payload"
          },
          {
            "type": "hm://hyper.media/null"
          }
        ]
      },
      "required": true,
      "description": "Results and rendering data for the block, or `null` when the query has no results."
    }
  },
  "description": "Runs a Query block's query and returns the results plus the per-item interaction summaries and author metadata its rendering needs, or null."
}
