{
  "type": "hm://hyper.media/struct",
  "properties": {
    "key": {
      "value": "ListCapabilities",
      "required": true,
      "description": "Method key, always `ListCapabilities`."
    },
    "input": {
      "value": {
        "type": "hm://hyper.media/struct",
        "properties": {
          "targetId": {
            "value": {
              "type": "hm://hyper.media/rpc/type/id"
            },
            "required": true,
            "description": "Id of the document the capabilities are granted on."
          }
        }
      },
      "required": true,
      "description": "The document whose capabilities to list."
    },
    "output": {
      "value": {
        "type": "hm://hyper.media/struct",
        "properties": {
          "capabilities": {
            "value": {
              "type": "hm://hyper.media/list",
              "items": {
                "type": "hm://hyper.media/rpc/type/raw-capability"
              }
            },
            "required": true,
            "description": "Raw capability records for the target."
          }
        }
      },
      "required": true,
      "description": "Capabilities granted on the target."
    }
  },
  "description": "Returns the raw capabilities granted on a target document, given its id."
}
