      },
      "description": "The faction that holds this place."
    },
    "coordinates": {
      "value": {
        "type": "hm://hyper.media/ipfs-url",
        "target": "hm://hyper.media/example/geo"
      },
      "description": "An `ipfs://` object conforming to Geo point."
    },
    "map": {
      "value": {
        "type": "hm://hyper.media/ipfs-url"
      },
      "description": "A map image file on IPFS."
