{
  "type": "hm://hyper.media/struct",
  "properties": {
    "kind": {
      "value": {
        "anyOf": [
          "city",
          "town",
          "village",
          "fortress",
          "ruin",
          "wilderness",
          "realm"
        ]
      },
      "required": true
    },
    "founded": {
      "value": {
        "type": "hm://hyper.media/date"
      },
      "description": "Founding date."
    },
    "region": {
      "value": {
        "type": "hm://hyper.media/hm-url",
