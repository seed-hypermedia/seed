{
  "type": "hm://hyper.media/struct",
  "properties": {
    "name": {
      "value": {
        "type": "hm://hyper.media/string"
      },
      "required": true,
      "description": "Folder name."
    },
    "files": {
      "value": {
        "type": "hm://hyper.media/list",
        "items": {
          "type": "hm://hyper.media/link",
          "target": "hm://hyper.media/example/file"
        }
      },
      "description": "Links to the files directly in this folder."
    },
    "subfolders": {
      "value": {
        "type": "hm://hyper.media/list",
        "items": {
          "type": "hm://hyper.media/link",
          "target": "hm://hyper.media/example/folder"
        }
      },
      "description": "Links to the folders directly inside this folder."
    }
  },
  "description": "A folder with a name and links to its files and subfolders, showing mutually referencing types."
}
